#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
    exit 0
fi

font_dir="$HOME/.local/share/fonts/FiraCodeNerdFont"
font_url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.tar.xz"

# Font archive URL checksum trigger (bump when changing font source):
# firacode-nerd-font-latest
#
# chezmoi run_onchange_ re-runs this script only when the rendered content
# changes (including the trigger comment above). Do not add a local marker
# file that skips work — that would block intentional re-downloads.

parent="$(dirname "$font_dir")"
mkdir -p "$parent"

# Download and extract into a temporary directory first, then swap in only on
# success. A failed download must never leave the machine without fonts.
tmp="$(mktemp -d "$parent/.font-install.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL "$font_url" -o "$tmp/FiraCode.tar.xz"
mkdir "$tmp/extract"
tar -xJf "$tmp/FiraCode.tar.xz" -C "$tmp/extract"

rm -rf "$font_dir"
mv "$tmp/extract" "$font_dir"

# Only refresh the user font cache. Unscoped `fc-cache -f` also tries to
# rewrite system dirs (e.g. /usr/share/fonts/truetype) and fails without root.
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$HOME/.local/share/fonts"
fi

printf 'Installed FiraCode Nerd Font under %s\n' "$font_dir"
printf 'Select "FiraCode Nerd Font Mono" in your terminal emulator.\n'
printf 'WSL users: install the font on Windows too — see the README.\n'
